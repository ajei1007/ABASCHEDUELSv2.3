    "start": "yarn && vite",
    "start:beta": "vite --mode staging",
    "start:abc": "vite --mode production.abc",
    "start:jbk": "vite --mode production.jbk",
    "prebuild": "npm version patch && npm run generate-build-version",
    "generate-build-version": "node generate-build-version",
    "build": "yarn build:beta && yarn build:pedsplus && yarn build:abc && yarn build:app && yarn build:jbk",
    "build:beta": "vite build --mode staging",
    "build:abc": "vite build --mode production.abc",
    "build:app": "vite build --mode production.app",
    "build:jbk": "vite build --mode production.jbk",
    "build:pedsplus": "vite build --mode production.pedsplus",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "prepare": "cd .. && husky ./frontend/.husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ]
  },
