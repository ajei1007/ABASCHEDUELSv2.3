{
  "name": "abaschedules2",
  "description": "Backend of ABA Schedules V2",
  "scripts": {
    "prod": "node ./src/index.js",
    "dev": "yarn && node ./scripts/flushRedis.js && yarn db:update:dev && nodemon ./src/index.js",
    "db:sync": "node ./src/dbSync.js",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:dev": "npx sequelize-cli db:migrate --env dev",
    "db:migrate:beta": "npx sequelize-cli db:migrate --env beta",
    "db:migrate:prod": "npx sequelize-cli db:migrate --env jbk && npx sequelize-cli db:migrate --env pedsplus && npx sequelize-cli db:migrate --env app && npx sequelize-cli db:migrate --env abc",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:seed:reset": "npx sequelize-cli db:seed:undo:all && npx sequelize-cli db:seed:all",
    "db:drop": "npx sequelize-cli db:drop",
    "db:create": "npx sequelize-cli db:create",
    "db:reset": "yarn db:drop && yarn db:create && yarn db:update",
    "test": "cross-env APP_ENV=test npx sequelize-cli db:migrate --env test && jest",
    "test:watch": "jest --watch",
    "run:test": "node ./src/integration/test_file.js",
    "db:update": "yarn db:migrate && yarn db:sync",
    "db:update:dev": "yarn db:migrate:dev && yarn db:sync",
    "db:update:beta": "yarn db:migrate:beta && yarn db:sync",
    "db:update:prod": "yarn db:migrate:prod && yarn db:sync"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.787.0",
    "@googlemaps/google-maps-services-js": "^3.4.1",
    "@mattermost/client": "^10.8.0",
    "@sentry/node": "^10.6.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "atatus-nodejs": "^1.6.7",
    "aws-sdk": "^2.1692.0",
    "axios-cookiejar-support": "^6.0.2",
    "bcrypt": "^5.1.1",
    "cheerio": "^1.1.0",
    "compression": "^1.8.0",
    "convert-units": "^2.3.4",
    "cookie": "^0.7.2",
    "cors": "2.8.5",
    "dotenv": "^16.4.7",
    "expo-server-sdk": "^3.14.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "form-data": "^4.0.2",
    "formidable": "^1.2.6",
    "geolib": "^3.3.4",
    "helmet": "^4.6.0",
    "http-status-codes": "^2.3.0",
    "ics": "^3.8.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^8.5.1",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.48",
    "multer": "^1.4.5-lts.2",
    "mysql2": "^2.3.3",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.0",
    "passport": "^0.7.0",
    "passport-google-oauth2": "^0.2.0",
    "passport-jwt": "^4.0.1",
    "passport-microsoft": "^0.1.0",
    "pg": "^8.14.1",
    "pg-hstore": "^2.3.4",
    "puppeteer": "^19.11.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-recaptcha": "^3.6.8",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.0",
    "rrule": "^2.8.1",
    "sequelize": "^6.37.7",
    "socket.io": "^4.8.1",
    "sqlite": "^4.0.25",
    "stripe": "^17.7.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.3",
    "tough-cookie": "^5.1.2",
    "uuid": "^9.0.1",
    "winston": "^3.17.0",
    "winston-cloudwatch": "^6.3.0",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true,
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "@types/jest": "^29.5.0",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "node-mocks-http": "^1.16.2",
    "nodemon": "^2.0.22",
    "sequelize-cli": "^6.6.2",
    "typescript": "^5.8.3",
    "typescript-json-schema": "^0.65.1"
  }
}
